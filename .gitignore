# テンプレートから生成されるファイル (個人情報を含む)
config/git/conf.d/user.conf
config/git/conf.d/accounts/*.conf
config/git/conf.d/accounts/accounts.list

# 実行時に生成されるもの
config/zsh/.zcompdump*

# zj-radar が配置するもの (zj-radar setup zellij --download で再取得できる)
config/zellij/plugins/
config/zellij/**/*.zj-radar.bak

/.claude/
/.mcp.json
/.serena/
